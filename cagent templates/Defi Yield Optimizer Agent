from web3 import Web3
import requests
import json
from dataclasses import dataclass

# Connect to Ethereum node
web3 = Web3(Web3.HTTPProvider("https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID"))
assert web3.isConnected(), "Failed to connect to Ethereum node"

@dataclass
class Protocol:
    name: str
    contract_address: str
    abi_url: str

# Protocol definitions
PROTOCOLS = [
    Protocol(
        name="Aave",
        contract_address="0x3f...",  # Example
        abi_url="https://api.etherscan.io/api?module=contract&action=getabi&address=0x3f..."
    ),
    Protocol(
        name="Compound",
        contract_address="0x6d...",
        abi_url="https://api.etherscan.io/api?module=contract&action=getabi&address=0x6d..."
    ),
]

# Simulated APYs
SIMULATED_APY = {
    "Aave": 0.045,
    "Compound": 0.038
}

def get_contract_abi(abi_url):
    try:
        response = requests.get(abi_url)
        response.raise_for_status()
        abi_data = response.json()
        return json.loads(abi_data["result"])
    except Exception as e:
        raise RuntimeError(f"Failed to fetch ABI from {abi_url}: {e}")

# Initialize contracts once
def initialize_contracts(protocols):
    contracts = {}
    for protocol in protocols:
        abi = get_contract_abi(protocol.abi_url)
        contract = web3.eth.contract(address=protocol.contract_address, abi=abi)
        contracts[protocol.name] = contract
    return contracts

class YieldOptimizer:
    def __init__(self, wallet_address, private_key, contracts, protocols):
        self.wallet_address = wallet_address
        self.private_key = private_key
        self.contracts = contracts
        self.protocols = protocols

    def fetch_apy(self, protocol_name):
        return SIMULATED_APY.get(protocol_name, 0)

    def find_best_yield(self):
        return max(
            ((p, self.fetch_apy(p.name)) for p in self.protocols),
            key=lambda x: x[1],
            default=(None, 0)
        )

    def allocate_funds(self, protocol, amount):
        contract = self.contracts[protocol.name]
        nonce = web3.eth.getTransactionCount(self.wallet_address)
        tx = contract.functions.deposit().buildTransaction({
            'from': self.wallet_address,
            'value': amount,
            'gas': 2000000,
            'gasPrice': web3.toWei('50', 'gwei'),
            'nonce': nonce,
        })
        signed_tx = web3.eth.account.signTransaction(tx, self.private_key)
        tx_hash = web3.eth.sendRawTransaction(signed_tx.rawTransaction)
        return tx_hash

    def optimize(self, amount):
        best_protocol, best_apy = self.find_best_yield()
        if best_protocol:
            print(f"Allocating to {best_protocol.name} with APY: {best_apy*100:.2f}%")
            tx_hash = self.allocate_funds(best_protocol, amount)
            print(f"Transaction hash: {tx_hash.hex()}")
        else:
            print("No optimal protocol found.")

# Main script
if __name__ == "__main__":
    WALLET_ADDRESS = "0xYourWalletAddress"
    PRIVATE_KEY = "YourPrivateKey"
    AMOUNT = web3.toWei(1, 'ether')

    contracts = initialize_contracts(PROTOCOLS)
    optimizer = YieldOptimizer(WALLET_ADDRESS, PRIVATE_KEY, contracts, PROTOCOLS)
    optimizer.optimize(AMOUNT)
