import json
import logging
import time
from web3 import Web3
from web3.exceptions import ContractLogicError

# Configuration constants
INFURA_URL = "https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID"
PRIVATE_KEY = "YOUR_PRIVATE_KEY"
CONTRACT_ADDRESS = "0xYourContractAddress"
ABI_PATH = "contract_abi.json"
CHAIN_ID = 1  # Ethereum Mainnet
GAS_LIMIT = 300000
GAS_PRICE_GWEI = 50
DECISION_THRESHOLD = 100  # ETH

# Setup logging
logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s")

def load_web3():
    web3 = Web3(Web3.HTTPProvider(INFURA_URL))
    if not web3.isConnected():
        raise ConnectionError("Unable to connect to the Ethereum network.")
    return web3

def load_contract(web3):
    with open(ABI_PATH) as abi_file:
        abi = json.load(abi_file)
    return web3.eth.contract(address=Web3.to_checksum_address(CONTRACT_ADDRESS), abi=abi)

def get_account(web3):
    account = web3.eth.account.from_key(PRIVATE_KEY)
    return account.address, account

def evaluate_dispute(dispute_data):
    claim_amount = dispute_data.get("claimAmount", 0)
    return claim_amount <= DECISION_THRESHOLD

def build_transaction(web3, contract_function, account_address):
    return contract_function.build_transaction({
        'chainId': CHAIN_ID,
        'gas': GAS_LIMIT,
        'gasPrice': web3.to_wei(GAS_PRICE_GWEI, 'gwei'),
        'nonce': web3.eth.get_transaction_count(account_address),
    })

def submit_decision(web3, contract, account, dispute_id, decision):
    try:
        txn = build_transaction(web3, contract.functions.submitDecision(dispute_id, decision), account.address)
        signed_txn = web3.eth.account.sign_transaction(txn, private_key=PRIVATE_KEY)
        tx_hash = web3.eth.send_raw_transaction(signed_txn.rawTransaction)
        logging.info(f"Decision submitted for dispute {dispute_id}. Tx Hash: {tx_hash.hex()}")
    except Exception as e:
        logging.error(f"Error submitting decision for dispute {dispute_id}: {e}")

def handle_event(web3, contract, account, event):
    try:
        dispute_id = event["args"]["disputeId"]
        dispute_data = contract.functions.getDispute(dispute_id).call()
        logging.info(f"Evaluating dispute {dispute_id}")
        decision = evaluate_dispute(dispute_data)
        submit_decision(web3, contract, account, dispute_id, decision)
    except ContractLogicError as cle:
        logging.error(f"Smart contract logic error: {cle}")
    except Exception as e:
        logging.error(f"Error handling event: {e}")

def main():
    web3 = load_web3()
    contract = load_contract(web3)
    account_address, account = get_account(web3)
    logging.info("Arbitration agent started.")
    
    event_filter = contract.events.DisputeCreated.create_filter(fromBlock='latest')

    while True:
        try:
            events = event_filter.get_new_entries()
            for event in events:
                handle_event(web3, contract, account, event)
            time.sleep(5)  # Prevents tight loop
        except Exception as e:
            logging.error(f"Error in main loop: {e}")
            time.sleep(10)

if __name__ == "__main__":
    main()
