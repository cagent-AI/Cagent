# ---------------------- Web3 Setup ----------------------
web3 = Web3(Web3.HTTPProvider(INFURA_URL))
if not web3.isConnected():
    raise ConnectionError("Unable to connect to the blockchain")

ERC20_ABI = [
    {
        "constant": True,
        "inputs": [{"name": "_owner", "type": "address"}],
        "name": "balanceOf",
        "outputs": [{"name": "balance", "type": "uint256"}],
        "type": "function"
    },
    {
        "constant": False,
        "inputs": [{"name": "_to", "type": "address"}, {"name": "_value", "type": "uint256"}],
        "name": "transfer",
        "outputs": [{"name": "", "type": "bool"}],
        "type": "function"
    },
    {
        "constant": True,
        "inputs": [],
        "name": "decimals",
        "outputs": [{"name": "", "type": "uint8"}],
        "type": "function"
    }
]

# ---------------------- Utility Classes ----------------------

class Token:
    def __init__(self, address):
        self.address = Web3.toChecksumAddress(address)
        self.contract = web3.eth.contract(address=self.address, abi=ERC20_ABI)
        self._decimals = self.contract.functions.decimals().call()

    def get_balance(self, wallet_address):
        raw_balance = self.contract.functions.balanceOf(Web3.toChecksumAddress(wallet_address)).call()
        return raw_balance / (10 ** self._decimals)

class Trader:
    def __init__(self, wallet_address, token: Token, base_token: Token):
        self.wallet = wallet_address
        self.token = token
        self.base_token = base_token

    def get_token_price(self):
        # TODO: Replace with real oracle/API call
        return 100

    def execute_trade(self, amount, action):
        print(f"[TRADE] {action.upper()} {amount:.6f} tokens")
        # TODO: Implement actual trade logic

    def evaluate_market(self):
        token_price = self.get_token_price()
        token_balance = self.token.get_balance(self.wallet)
        base_balance = self.base_token.get_balance(self.wallet)

        print(f"[INFO] Price: {token_price}, Token Balance: {token_balance:.4f}, Base Balance: {base_balance:.4f}")

        if token_price < REFERENCE_PRICE * BUY_THRESHOLD and base_balance > 0:
            amount_to_buy = base_balance / token_price
            self.execute_trade(amount_to_buy, "buy")

        elif token_price > REFERENCE_PRICE * SELL_THRESHOLD and token_balance > 0:
            self.execute_trade(token_balance, "sell")

# ---------------------- Main Loop ----------------------

def main():
    token = Token(TOKEN_ADDRESS)
    base_token = Token(BASE_TOKEN_ADDRESS)
    trader = Trader(WALLET_ADDRESS, token, base_token)

    while True:
        try:
            trader.evaluate_market()
        except Exception as e:
            print(f"[ERROR] {e}")
        time.sleep(POLL_INTERVAL)

if __name__ == "__main__":
    main()
